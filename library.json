{
  "name": "hub75",
  "description": "pimoroni-pico hub75 driver, adjusted for ZeDMD",
  "version": "0.1.0",
  "downloadUrl": "https://github.com/PPUC/pimoroni-pico/archive/zedmd.zip",
  "frameworks": "arduino",
  "platforms": "platformio/raspberrypi",
  "build": {
    "flags": [
      "-DCMAKE_BUILD_TYPE=Release",
      "-DENABLE_PICO_GRAPHICS=OFF"
    ],
    "srcDir": "drivers/hub75",
    "srcFilter": "+<*>",
  }
  "headers": "hub75.hpp",
  "license": "MIT"
}
